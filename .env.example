# ===========================================
# NepStudent Platform — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# ---- Database & Cache ----
DATABASE_URL="postgresql://nepstudent:nepstudent_dev@localhost:5432/nepstudent?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- API Server ----
API_PORT=4000
API_HOST=localhost
NODE_ENV=development

# ---- JWT Authentication ----
JWT_ACCESS_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Bcrypt ----
BCRYPT_ROUNDS=12

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Email (future — use console logger for now) ----
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# ---- Object Storage (Cloudflare R2-compatible) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=nepstudent-documents
STORAGE_PUBLIC_URL=

# ---- Verification Policy ----
VERIFICATION_EXPIRY_MONTHS=12
ROSTER_MATCH_MAX_ATTEMPTS=5
ROSTER_MATCH_WINDOW_MINUTES=60
REJECTION_COOLDOWN_HOURS=24
REVIEW_CLAIM_EXPIRY_MINUTES=30

# ---- Next.js (Web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
