datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Offer {
  id                String   @id @default(uuid())
  merchantId        String
  title             String
  description       String
  discountType      String   @default("PERCENTAGE")
  discountValue     Float
  perStudentLimit   Int      @default(1)
  totalQuota        Int?
  remainingQuota    Int?
  validUntil        DateTime
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("offers")
}
