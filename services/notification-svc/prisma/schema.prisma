datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  channel   String
  subject   String?
  status    String   @default("SENT")
  createdAt DateTime @default(now())

  @@map("notification_logs")
}
