datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Merchant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  category     String
  city         String   @default("Kathmandu")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("merchants")
}
